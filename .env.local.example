# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Marketing API (System User Token com permissao ads_read na conta de anuncios)
META_ACCESS_TOKEN=your-meta-system-user-token

# Protege as rotas de cron/admin (/api/cron/*, /api/admin/sync-stract —
# Authorization: Bearer <valor>). Etapa 2A (Auditoria de Seguranca): agora
# fail-closed (lib/cron-auth.ts) — sem essa variavel, ou com ela vazia,
# TODAS essas rotas negam a chamada (nunca mais "abre se faltar"). Obrigatoria
# em qualquer ambiente onde os crons devem rodar de verdade, inclusive dev
# local se voce quiser testa-los.
CRON_SECRET=

# Etapa 2C (Rate Limit Distribuido): credenciais REST do Upstash Redis
# (server-only — nunca NEXT_PUBLIC_*, nunca chegam ao browser). Sem elas,
# o rate limit (lib/rate-limit.ts) fica fail-closed em producao (NODE_ENV=
# production: build/preview/production da Vercel, ou "next build && next
# start" local) — as rotas protegidas (/api/clients/[id]/performance-report,
# /api/cron/*, /api/admin/sync-stract) respondem 503 em vez de rodar sem
# limite. Em desenvolvimento (next dev) sem essas variaveis, cai num
# fallback em memoria só de dev (isolado, nunca usado em producao).
# Se voce conectar o Upstash pelo marketplace da Vercel em vez de criar a
# conta direto no Upstash, a integracao pode nomear essas variaveis como
# KV_REST_API_URL/KV_REST_API_TOKEN — o codigo aceita os dois nomes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
