# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Marketing API (System User Token com permissao ads_read na conta de anuncios)
META_ACCESS_TOKEN=your-meta-system-user-token

# Opcional: protege /api/cron/sync-meta (Authorization: Bearer <valor>).
# Sem essa variavel a rota fica aberta (ok para dev, defina em producao).
CRON_SECRET=
