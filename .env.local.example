# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Meta Marketing API (System User Token com permissao ads_read na conta de anuncios)
META_ACCESS_TOKEN=your-meta-system-user-token

# Protege as rotas de cron/admin (/api/cron/*, /api/admin/sync-stract —
# Authorization: Bearer <valor>). Etapa 2A (Auditoria de Seguranca): agora
# fail-closed (lib/cron-auth.ts) — sem essa variavel, ou com ela vazia,
# TODAS essas rotas negam a chamada (nunca mais "abre se faltar"). Obrigatoria
# em qualquer ambiente onde os crons devem rodar de verdade, inclusive dev
# local se voce quiser testa-los.
CRON_SECRET=
